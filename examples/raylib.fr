// Text codepoints management functions (unicode byteacters)

// Load UTF-8 text encoded from codepoints array
public native fn LoadUTF8(codepoints: *c_int, length: c_int) -> *byte;

// Unload UTF-8 text encoded from codepoints array
public native fn UnloadUTF8(text: *byte) -> void;

// Load all codepoints from a UTF-8 text string, codepoints count returned by parameter
public native fn LoadCodepoints(text: *byte, count: *c_int) -> *c_int;

// Unload codepoints data from memory
public native fn UnloadCodepoints(codepoints: *c_int) -> void;

// Get total number of codepoints in a UTF-8 encoded string
public native fn GetCodepointCount(text: *byte) -> c_int;

// Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure
public native fn GetCodepoint(text: *byte, codepointSize: *c_int) -> c_int;

// Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure
public native fn GetCodepointNext(text: *byte, codepointSize: *c_int) -> c_int;

// Get previous codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure
public native fn GetCodepointPrevious(text: *byte, codepointSize: *c_int) -> c_int;

