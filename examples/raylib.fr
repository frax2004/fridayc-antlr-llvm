// Get upper case version of provided string
public native fn TextToUpper(text: *byte) -> *byte;

// Get lower case version of provided string
public native fn TextToLower(text: *byte) -> *byte;

// Get Pascal case notation version of provided string
public native fn TextToPascal(text: *byte) -> *byte;

// Get Snake case notation version of provided string
public native fn TextToSnake(text: *byte) -> *byte;

// Get Camel case notation version of provided string
public native fn TextToCamel(text: *byte) -> *byte;

// Get c_integer value from text
