// Unload model (including meshes) from memory (and: RAM/or VRAM)
public native fn UnloadModel(model: Model) -> void;

// Compute model bounding box limits (considers all meshes)
public native fn GetModelBoundingBox(model: Model) -> BoundingBox;


// Model drawing functions

// Draw a model (with texture if set)
