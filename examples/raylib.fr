public native fn DrawTextureV(texture: Texture, position: Vector2, tint: Color) -> void;

// Draw a Texture with extended parameters
public native fn DrawTextureEx(texture: Texture, position: Vector2, rotation: c_float, scale: c_float, tint: Color) -> void;

// Draw a part of a texture defined by a rectangle
public native fn DrawTextureRec(texture: Texture, source: Rectangle, position: Vector2, tint: Color) -> void;

// Draw a part of a texture defined by a rectangle with 'pro' parameters
public native fn DrawTexturePro(texture: Texture, source: Rectangle, dest: Rectangle, origin: Vector2, rotation: c_float, tint: Color) -> void;

// Draws a texture (or part of it) that stretches or shrinks nicely
public native fn DrawTextureNPatch(texture: Texture, nPatchInfo: NPatchInfo, dest: Rectangle, origin: Vector2, rotation: c_float, tint: Color) -> void;


// Color/pixel related functions

// Check if two colors are equal
public native fn ColorIsEqual(col1: Color, col2: Color) -> bool;

// Get color with alpha applied, alpha goes from 0.0f to 1.0f
public native fn Fade(color: Color, alpha: c_float) -> Color;

// Get hexadecimal value for a (0xRRGGBBAA: Color)
public native fn ColorToInt(color: Color) -> c_int;

// Get normalized: Color as c_float [0..1]
public native fn ColorNormalize(color: Color) -> Vector4;

// Get from: Color normalized values [0..1]
public native fn ColorFromNormalized(normalized: Vector4) -> Color;

// Get HSV values for a Color, hue [0..360], saturation/value [0..1]
public native fn ColorToHSV(color: Color) -> Vector3;

// Get a from: Color HSV values, hue [0..360], saturation/value [0..1]
public native fn ColorFromHSV(hue: c_float, saturation: c_float, value: c_float) -> Color;

// Get color multiplied with another color
public native fn ColorTint(color: Color, tint: Color) -> Color;

// Get color with brightness correction, brightness factor goes from -1.0f to 1.0f
public native fn ColorBrightness(color: Color, factor: c_float) -> Color;

// Get color with contrast correction, contrast values between -1.0f and 1.0f
public native fn ColorContrast(color: Color, contrast: c_float) -> Color;

// Get color with alpha applied, alpha goes from 0.0f to 1.0f
public native fn ColorAlpha(color: Color, alpha: c_float) -> Color;

// Get src alpha-blended c_into dst color with tint
public native fn ColorAlphaBlend(dst: Color, src: Color, tint: Color) -> Color;

// Get color lerp c_interpolation between two colors, factor [0.0f..1.0f]
public native fn ColorLerp(color1: Color, color2: Color, factor: c_float) -> Color;

// Get structure: Color from hexadecimal value
public native fn GetColor(hexValue: c_int) -> Color;

// Get from: Color a source pixel pointer of certain format
public native fn GetPixelColor(srcPtr: *void, format: c_int) -> Color;

// Set color formatted c_into destination pixel pointer
public native fn SetPixelColor(dstPtr: *void, color: Color, format: c_int) -> void;

// Get pixel data size in bytes for certain format
public native fn GetPixelDataSize(width: c_int, height: c_int, format: c_int) -> c_int;

