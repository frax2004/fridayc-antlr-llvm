// Texture loading functions

// NOTE: These functions require GPU access

// Load texture from file c_into GPU memory (VRAM)
public native fn LoadTexture(fileName: *byte) -> Texture;

// Load texture from image data
public native fn LoadTextureFromImage(image: Image) -> Texture;

// Load cubemap from image, multiple image cubemap layouts supported
public native fn LoadTextureCubemap(image: Image, layout: c_int) -> Texture;

// Load texture for rendering (framebuffer)
public native fn LoadRenderTexture(width: c_int, height: c_int) -> RenderTexture;

// Check if a texture is valid (loaded in GPU)
public native fn IsTextureValid(texture: Texture) -> bool;

// Unload texture from GPU memory (VRAM)
public native fn UnloadTexture(texture: Texture) -> void;

// Check if a render texture is valid (loaded in GPU)
public native fn IsRenderTextureValid(target: RenderTexture) -> bool;

// Unload render texture from GPU memory (VRAM)
public native fn UnloadRenderTexture(target: RenderTexture) -> void;

// Update GPU texture with new data (pixels should be able to fill texture)
public native fn UpdateTexture(texture: Texture, pixels: *void) -> void;

// Update GPU texture rectangle with new data (pixels and rec should fit in texture)
public native fn UpdateTextureRec(texture: Texture, rec: Rectangle, pixels: *void) -> void;


// Texture configuration functions

// Generate GPU mipmaps for a texture
public native fn GenTextureMipmaps(texture: *Texture) -> void;

// Set texture scaling filter mode
public native fn SetTextureFilter(texture: Texture, filter: c_int) -> void;

// Set texture wrapping mode
public native fn SetTextureWrap(texture: Texture, wrap: c_int) -> void;


