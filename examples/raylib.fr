public native fn IsFontValid(font: Font) -> bool;

// Load font data for further use
public native fn LoadFontData(fileData: *byte, dataSize: c_int, fontSize: c_int, codepoints: *c_int, codepointCount: c_int, type: c_int, glyphCount: *c_int) -> *GlyphInfo;

