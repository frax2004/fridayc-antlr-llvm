// Input Handling Functions (Module: core)


//------------------------------------------------------------------------------------



// Input-related functions: keyboard


// Check if a key has been pressed once
public native fn IsKeyPressed(key: c_int) -> bool;

// Check if a key has been pressed again
public native fn IsKeyPressedRepeat(key: c_int) -> bool;

// Check if a key is being pressed
public native fn IsKeyDown(key: c_int) -> bool;

// Check if a key has been released once
public native fn IsKeyReleased(key: c_int) -> bool;

// Check if a key is NOT being pressed
public native fn IsKeyUp(key: c_int) -> bool;

// Get key pressed (keycode), call it multiple times for keys queued, returns 0 when the queue is empty
public native fn GetKeyPressed() -> c_int;

// Get byte pressed (unicode), call it multiple times for bytes queued, returns 0 when the queue is empty
public native fn GetCharPressed() -> c_int;

// Get name of a QWERTY key on the current keyboard layout (eg returns string 'q' for KEY_A on an AZERTY keyboard)
public native fn GetKeyName(key: c_int) -> *byte;

// Set a custom key to exit program (default is ESC)
public native fn SetExitKey(key: c_int) -> void;


// Input-related functions: gamepads


// Check if a gamepad is available
public native fn IsGamepadAvailable(gamepad: c_int) -> bool;

// Get gamepad c_internal name id
public native fn GetGamepadName(gamepad: c_int) -> *byte;

// Check if a gamepad button has been pressed once
public native fn IsGamepadButtonPressed(gamepad: c_int, button: c_int) -> bool;

// Check if a gamepad button is being pressed
public native fn IsGamepadButtonDown(gamepad: c_int, button: c_int) -> bool;

// Check if a gamepad button has been released once
public native fn IsGamepadButtonReleased(gamepad: c_int, button: c_int) -> bool;

// Check if a gamepad button is NOT being pressed
public native fn IsGamepadButtonUp(gamepad: c_int, button: c_int) -> bool;

// Get the last gamepad button pressed
