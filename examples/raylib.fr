// Draw bounding box (wires)
public native fn DrawBoundingBox(box: BoundingBox, color: Color) -> void;

// Draw a billboard texture
public native fn DrawBillboard(camera: Camera3D, texture: Texture, position: Vector3, scale: c_float, tint: Color) -> void;

// Draw a billboard texture defined by source
public native fn DrawBillboardRec(camera: Camera3D, texture: Texture, source: Rectangle, position: Vector3, size: Vector2, tint: Color) -> void;

// Draw a billboard texture defined by source and rotation
public native fn DrawBillboardPro(camera: Camera3D, texture: Texture, source: Rectangle, position: Vector3, up: Vector3, size: Vector2, origin: Vector2, rotation: c_float, tint: Color) -> void;


// Mesh management functions

// Upload mesh vertex data in GPU and provide VAO/VBO ids
public native fn UploadMesh(mesh: *Mesh, dynamic: bool) -> void;

// Update mesh vertex data in GPU for a specific buffer index
public native fn UpdateMeshBuffer(mesh: Mesh, index: c_int, data: *void, dataSize: c_int, offset: c_int) -> void;

// Unload mesh data from CPU and GPU
public native fn UnloadMesh(mesh: Mesh) -> void;

// Draw a 3d mesh with material and transform
public native fn DrawMesh(mesh: Mesh, material: Material, transform: Matrix) -> void;

// Draw multiple mesh instances with material and different transforms
public native fn DrawMeshInstanced(mesh: Mesh, material: Material, transforms: *Matrix, instances: c_int) -> void;

// Compute mesh bounding box limits
public native fn GetMeshBoundingBox(mesh: Mesh) -> BoundingBox;

// Compute mesh tangents
public native fn GenMeshTangents(mesh: *Mesh) -> void;

// Export mesh data to file, returns true on success
public native fn ExportMesh(mesh: Mesh, fileName: *byte) -> bool;

// Export mesh as code file (.h) defining multiple arrays of vertex attributes
public native fn ExportMeshAsCode(mesh: Mesh, fileName: *byte) -> bool;


// Mesh generation functions

// Generate polygonal mesh
public native fn GenMeshPoly(sides: c_int, radius: c_float) -> Mesh;

// Generate plane mesh (with subdivisions)
public native fn GenMeshPlane(width: c_float, length: c_float, resX: c_int, resZ: c_int) -> Mesh;

// Generate cuboid mesh
public native fn GenMeshCube(width: c_float, height: c_float, length: c_float) -> Mesh;

// Generate sphere mesh (standard sphere)
public native fn GenMeshSphere(radius: c_float, rings: c_int, slices: c_int) -> Mesh;

// Generate half-sphere mesh (no bottom cap)
public native fn GenMeshHemiSphere(radius: c_float, rings: c_int, slices: c_int) -> Mesh;

// Generate cylinder mesh
public native fn GenMeshCylinder(radius: c_float, height: c_float, slices: c_int) -> Mesh;

// Generate cone/pyramid mesh
public native fn GenMeshCone(radius: c_float, height: c_float, slices: c_int) -> Mesh;

// Generate torus mesh
public native fn GenMeshTorus(radius: c_float, size: c_float, radSeg: c_int, sides: c_int) -> Mesh;

// Generate trefoil knot mesh
public native fn GenMeshKnot(radius: c_float, size: c_float, radSeg: c_int, sides: c_int) -> Mesh;

// Generate heightmap mesh from image data
public native fn GenMeshHeightmap(heightmap: Image, size: Vector3) -> Mesh;

// Generate cubes-based map mesh from image data
public native fn GenMeshCubicmap(cubicmap: Image, cubeSize: Vector3) -> Mesh;


// Material loading/unloading functions

// Load materials from model file
public native fn LoadMaterials(fileName: *byte, materialCount: *c_int) -> *Material;

// Load default material (Supports: DIFFUSE, SPECULAR, NORMAL maps)
public native fn LoadMaterialDefault() -> Material;

// Check if a material is valid (shader assigned, map textures loaded in GPU)
public native fn IsMaterialValid(material: Material) -> bool;

// Unload material from GPU memory (VRAM)
public native fn UnloadMaterial(material: Material) -> void;

// Set texture for a material map type (MATERIAL_MAP_DIFFUSE, MATERIAL_MAP_SPECULAR...)
public native fn SetMaterialTexture(material: *Material, mapType: c_int, texture: Texture) -> void;

// Set material for a mesh
public native fn SetModelMeshMaterial(model: *Model, meshId: c_int, materialId: c_int) -> void;


// Model animations loading/unloading functions

// Load model animations from file
public native fn LoadModelAnimations(fileName: *byte, animCount: *c_int) -> *ModelAnimation;

// Update model animation pose (vertex buffers and bone matrices)
public native fn UpdateModelAnimation(model: Model, anim: ModelAnimation, frame: c_float) -> void;

// Update model animation pose, blending two animations
public native fn UpdateModelAnimationEx(model: Model, animA: ModelAnimation, frameA: c_float, animB: ModelAnimation, frameB: c_float, blend: c_float) -> void;

// Unload animation array data
public native fn UnloadModelAnimations(animations: *ModelAnimation, animCount: c_int) -> void;

// Check model animation skeleton match
public native fn IsModelAnimationValid(model: Model, anim: ModelAnimation) -> bool;


// Collision detection functions

// Check collision between two spheres
public native fn CheckCollisionSpheres(center1: Vector3, radius1: c_float, center2: Vector3, radius2: c_float) -> bool;

// Check collision between two bounding boxes
public native fn CheckCollisionBoxes(box1: BoundingBox, box2: BoundingBox) -> bool;

// Check collision between box and sphere
public native fn CheckCollisionBoxSphere(box: BoundingBox, center: Vector3, radius: c_float) -> bool;

// Get collision info between ray and sphere
public native fn GetRayCollisionSphere(ray: Ray, center: Vector3, radius: c_float) -> RayCollision;

// Get collision info between ray and box
public native fn GetRayCollisionBox(ray: Ray, box: BoundingBox) -> RayCollision;

// Get collision info between ray and mesh
public native fn GetRayCollisionMesh(ray: Ray, mesh: Mesh, transform: Matrix) -> RayCollision;

// Get collision info between ray and triangle
public native fn GetRayCollisionTriangle(ray: Ray, p1: Vector3, p2: Vector3, p3: Vector3) -> RayCollision;

// Get collision info between ray and quad
public native fn GetRayCollisionQuad(ray: Ray, p1: Vector3, p2: Vector3, p3: Vector3, p4: Vector3) -> RayCollision;


// Audio device management functions

// Initialize audio device and context
public native fn InitAudioDevice() -> void;

// Close the audio device and context
public native fn CloseAudioDevice() -> void;

// Check if audio device has been initialized successfully
public native fn IsAudioDeviceReady() -> bool;

// Set master volume (listener)
public native fn SetMasterVolume(volume: c_float) -> void;

// Get master volume (listener)
public native fn GetMasterVolume() -> c_float;


// Wave/Sound loading/unloading functions

// Load wave data from file
public native fn LoadWave(fileName: *byte) -> Wave;

// Load wave from memory buffer, fileType refers to extension: i.e. '.wav'
public native fn LoadWaveFromMemory(fileType: *byte, fileData: *byte, dataSize: c_int) -> Wave;

// Checks if wave data is valid (data loaded and parameters)
public native fn IsWaveValid(wave: Wave) -> bool;

// Load sound from file
public native fn LoadSound(fileName: *byte) -> Sound;

// Load sound from wave data
public native fn LoadSoundFromWave(wave: Wave) -> Sound;

// Create a new sound that shares the same sample data as the source sound, does not own the sound data
public native fn LoadSoundAlias(source: Sound) -> Sound;

// Checks if a sound is valid (data loaded and buffers initialized)
public native fn IsSoundValid(sound: Sound) -> bool;

// Update sound buffer with new data (default data format: 32 bit c_float, stereo)
public native fn UpdateSound(sound: Sound, data: *void, sampleCount: c_int) -> void;

// Unload wave data
public native fn UnloadWave(wave: Wave) -> void;

// Unload sound
public native fn UnloadSound(sound: Sound) -> void;

// Unload a sound alias (does not deallocate sample data)
public native fn UnloadSoundAlias(alias: Sound) -> void;

// Export wave data to file, returns true on success
public native fn ExportWave(wave: Wave, fileName: *byte) -> bool;

// Export wave sample data to code (.h), returns true on success
public native fn ExportWaveAsCode(wave: Wave, fileName: *byte) -> bool;


// Wave/Sound management functions

// Play a sound
public native fn PlaySound(sound: Sound) -> void;

// Stop playing a sound
public native fn StopSound(sound: Sound) -> void;

// Pause a sound
public native fn PauseSound(sound: Sound) -> void;

// Resume a paused sound
public native fn ResumeSound(sound: Sound) -> void;

// Check if a sound is currently playing
public native fn IsSoundPlaying(sound: Sound) -> bool;

// Set volume for a sound (1.0 is max level)
public native fn SetSoundVolume(sound: Sound, volume: c_float) -> void;

// Set pitch for a sound (1.0 is base level)
public native fn SetSoundPitch(sound: Sound, pitch: c_float) -> void;

// Set pan for a sound (-1.0 left, 0.0 center, 1.0 right)
public native fn SetSoundPan(sound: Sound, pan: c_float) -> void;

// Copy a wave to a new wave
public native fn WaveCopy(wave: Wave) -> Wave;

// Crop a wave to defined frames range
public native fn WaveCrop(wave: *Wave, initFrame: c_int, finalFrame: c_int) -> void;

// Convert wave data to desired format
public native fn WaveFormat(wave: *Wave, sampleRate: c_int, sampleSize: c_int, channels: c_int) -> void;

// Load samples data from wave as a 32bit data: c_float array
public native fn LoadWaveSamples(wave: Wave) -> *c_float;

// Unload samples data loaded with LoadWaveSamples()
public native fn UnloadWaveSamples(samples: *c_float) -> void;


// Music management functions

// Load music stream from file
public native fn LoadMusicStream(fileName: *byte) -> Music;

// Load music stream from data
public native fn LoadMusicStreamFromMemory(fileType: *byte, data: *byte, dataSize: c_int) -> Music;

// Checks if a music stream is valid (context and buffers initialized)
public native fn IsMusicValid(music: Music) -> bool;

// Unload music stream
public native fn UnloadMusicStream(music: Music) -> void;

// Start music playing
public native fn PlayMusicStream(music: Music) -> void;

// Check if music is playing
public native fn IsMusicStreamPlaying(music: Music) -> bool;

// Updates buffers for music streaming
public native fn UpdateMusicStream(music: Music) -> void;

// Stop music playing
public native fn StopMusicStream(music: Music) -> void;

// Pause music playing
public native fn PauseMusicStream(music: Music) -> void;

// Resume playing paused music
public native fn ResumeMusicStream(music: Music) -> void;

// Seek music to a position (in seconds)
public native fn SeekMusicStream(music: Music, position: c_float) -> void;

// Set volume for music (1.0 is max level)
public native fn SetMusicVolume(music: Music, volume: c_float) -> void;

// Set pitch for a music (1.0 is base level)
public native fn SetMusicPitch(music: Music, pitch: c_float) -> void;

// Set pan for a music (-1.0 left, 0.0 center, 1.0 right)
public native fn SetMusicPan(music: Music, pan: c_float) -> void;

// Get music time length (in seconds)
public native fn GetMusicTimeLength(music: Music) -> c_float;

// Get current music time played (in seconds)
public native fn GetMusicTimePlayed(music: Music) -> c_float;


// AudioStream management functions

// Load audio stream (to stream raw audio pcm data)
public native fn LoadAudioStream(sampleRate: c_int, sampleSize: c_int, channels: c_int) -> AudioStream;

// Checks if an audio stream is valid (buffers initialized)
public native fn IsAudioStreamValid(stream: AudioStream) -> bool;

// Unload audio stream and free memory
public native fn UnloadAudioStream(stream: AudioStream) -> void;

// Update audio stream buffers with data
public native fn UpdateAudioStream(stream: AudioStream, data: *void, frameCount: c_int) -> void;

// Check if any audio stream buffers requires refill
public native fn IsAudioStreamProcessed(stream: AudioStream) -> bool;

// Play audio stream
public native fn PlayAudioStream(stream: AudioStream) -> void;

// Pause audio stream
public native fn PauseAudioStream(stream: AudioStream) -> void;

// Resume audio stream
public native fn ResumeAudioStream(stream: AudioStream) -> void;

// Check if audio stream is playing
public native fn IsAudioStreamPlaying(stream: AudioStream) -> bool;

// Stop audio stream
public native fn StopAudioStream(stream: AudioStream) -> void;

// Set volume for audio stream (1.0 is max level)
public native fn SetAudioStreamVolume(stream: AudioStream, volume: c_float) -> void;

// Set pitch for audio stream (1.0 is base level)
public native fn SetAudioStreamPitch(stream: AudioStream, pitch: c_float) -> void;

// Set pan for audio stream (-1.0 to 1.0 range, 0.0 is centered)
public native fn SetAudioStreamPan(stream: AudioStream, pan: c_float) -> void;

// Default size for new audio streams
public native fn SetAudioStreamBufferSizeDefault(size: c_int) -> void;

// Audio thread callback to request new data
public native fn SetAudioStreamCallback(stream: AudioStream, callback: fn(*void, c_int) -> void) -> void;


// Attach audio stream processor to stream, receives frames x 2 samples as 'c_float' (stereo)
public native fn AttachAudioStreamProcessor(stream: AudioStream, processor: fn(*void, c_int) -> void) -> void;

// Detach audio stream processor from stream
public native fn DetachAudioStreamProcessor(stream: AudioStream, processor: fn(*void, c_int) -> void) -> void;


// Attach audio stream processor to the entire audio pipeline, receives frames x 2 samples as 'c_float' (stereo)
public native fn AttachAudioMixedProcessor(processor: fn(*void, c_int) -> void) -> void;

// Detach audio stream processor from the entire audio pipeline
public native fn DetachAudioMixedProcessor(processor: fn(*void, c_int) -> void) -> void;

