namespace Raylib;

// Vector2, 2 components
public struct Vector2 {
  // Vector x component
  x: c_float;
  // Vector y component
  y: c_float;
}

// Vector3, 3 components
public struct Vector3 {
  //: Vector3;Vector x component
  x: c_float;
  // Vector y component
  y: c_float;
  // Vector z component
  z: c_float;
}

// Vector4, 4 components
public struct Vector4 {
  // Vector x component
  x: c_float;
  // Vector y component
  y: c_float;
  // Vector z component
  z: c_float;
  // Vector w component
  w: c_float;
}

// Matrix, 4x4 components, column major, OpenGL style, right-handed
public struct Matrix {
  // Matrix first row (4 components)
  m0: c_float; m4: c_float; m8: c_float; m12: c_float;
  // Matrix second row (4 components)
  m1: c_float; m5: c_float; m9: c_float; m13: c_float;
  // Matrix third row (4 components)
  m2: c_float; m6: c_float; m10: c_float; m14: c_float;
  // Matrix fourth row (4 components)
  m3: c_float; m7: c_float; m11: c_float; m15: c_float;
}

// Color, 4 components, R8G8B8A8 (32bit)
public struct Color {
  // Color red value
  r: byte;
  // Color green value
  g: byte;
  // Color blue value
  b: byte;
  // Color alpha value
  a: byte;

  public fn rgb(r: int, g: int, b: int) -> Color => new Color {
    r: r as byte,
    g: g as byte,
    b: b as byte,
    a: 255 as byte
  };
  
  public fn rgba(r: int, g: int, b: int, a: int) -> Color => new Color {
    r: r as byte,
    g: g as byte,
    b: b as byte,
    a: a as byte
  };
}

// Rectangle, 4 components
public struct Rectangle {
  // Rectangle top-left corner position x
  x: c_float;
  // Rectangle top-left corner position y
  y: c_float;
  // Rectangle width
  width: c_float;
  // Rectangle height
  height: c_float;
}

// Image, pixel data stored in CPU memory (RAM)
public struct Image {
  // Image raw data
  data: *void;
  // Image base width
  width: c_int;
  // Image base height
  height: c_int;
  // Mipmap levels, 1 by default
  mipmaps: c_int;
  // Data format (PixelFormat type)
  format: c_int;
}

// Texture, tex data stored in GPU memory (VRAM)
public struct Texture {
  // OpenGL texture id
  id: c_int;
  // Texture base width
  width: c_int;
  // Texture base height
  height: c_int;
  // Mipmap levels, 1 by default
  mipmaps: c_int;
  // Data format (PixelFormat type)
  format: c_int;
}

// RenderTexture, fbo for texture rendering
public struct RenderTexture {
  // OpenGL framebuffer object id
  id: c_int;
  // Color buffer attachment texture
  texture: Texture;
  // Depth buffer attachment texture
  depth: Texture;
}

// NPatchInfo, n-patch layout info
public struct NPatchInfo {
  // Texture source rectangle
  source: Rectangle;
  // Left border offset
  left: c_int;
  // Top border offset
  top: c_int;
  // Right border offset
  right: c_int;
  // Bottom border offset
  bottom: c_int;
  // Layout of the n-patch: 3x3, 1x3 or 3x1
  layout: c_int;
}

// GlyphInfo, font characters glyphs info
public struct GlyphInfo {
  // Character value (Unicode)
  value: c_int;
  // Character offset X when drawing
  offsetX: c_int;
  // Character offset Y when drawing
  offsetY: c_int;
  // Character advance position X
  advanceX: c_int;
  // Character image data
  image: Image;
}

// Font, font texture and GlyphInfo array data
public struct Font {
  // Base size (default chars height)
  baseSize: c_int;
  // Number of glyph characters
  glyphCount: c_int;
  // Padding around the glyph characters
  glyphPadding: c_int;
  // Texture atlas containing the glyphs
  texture: Texture;
  // Rectangles in texture for the glyphs
  recs: *Rectangle;
  // Glyphs info data
  glyphs: *GlyphInfo;
}

// Camera3D, defines position/orientation in 3d space
public struct Camera3D {
  // Camera3D position
  position: Vector3;
  // Camera3D target it looks-at
  target: Vector3;
  // Camera3D up vector (rotation over its axis)
  up: Vector3;
  // Camera3D field-of-view aperture in Y (degrees) in perspective, used as near plane width in orthographic
  fovy: c_float;
  // Camera3D projection: CAMERA_PERSPECTIVE or CAMERA_ORTHOGRAPHIC
  projection: c_int;
}

// Camera2D, defines position/orientation in 2d space
public struct Camera2D {
  // Camera2D offset (displacement from target)
  offset: Vector2;
  // Camera2D target (rotation and zoom origin)
  target: Vector2;
  // Camera2D rotation in degrees
  rotation: c_float;
  // Camera2D zoom (scaling), should be 1.0f by default
  zoom: c_float;
}

// Mesh, vertex data and vao/vbo
public struct Mesh {
  // Number of vertices stored in arrays
  vertexCount: c_int;
  // Number of triangles stored (indexed or not)
  triangleCount: c_int;

  // Vertex attributes data

  // Vertex position (XYZ - 3 components per vertex) (shader-location = 0)
  vertices: *c_float;
  // Vertex texture coordinates (UV - 2 components per vertex) (shader-location = 1)
  texcoords: *c_float;
  // Vertex texture second coordinates (UV - 2 components per vertex) (shader-location = 5)
  texcoords2: *c_float;
  // Vertex normals (XYZ - 3 components per vertex) (shader-location = 2)
  normals: *c_float;
  // Vertex tangents (XYZW - 4 components per vertex) (shader-location = 4)
  tangents: *c_float;
  // Vertex colors (RGBA - 4 components per vertex) (shader-location = 3)
  colors: *byte;
  // Vertex indices (in case vertex data comes indexed)
  indices: *c_short;

  // Animation vertex data

  // Animated vertex positions (after bones transformations)
  animVertices: *c_float;
  // Animated normals (after bones transformations)
  animNormals: *c_float;
  // Vertex bone ids, max 255 bone ids, up to 4 bones influence by vertex (skinning) (shader-location = 6)
  boneIds: *byte;
  // Vertex bone weight, up to 4 bones influence by vertex (skinning) (shader-location = 7)
  boneWeights: *c_float;
  // Bones animated transformation matrices
  boneMatrices: *Matrix;
  // Number of bones
  boneCount: c_int;

  // OpenGL identifiers

  // OpenGL Vertex Array Object id
  vaoId: c_int;
  // OpenGL Vertex Buffer Objects id (default vertex data)
  vboId: *c_int;
}

// Shader
public struct Shader {
  // Shader program id
  id: c_int;
  // Shader locations array (RL_MAX_SHADER_LOCATIONS)
  locs: *c_int;
}

// MaterialMap
public struct MaterialMap {
  // Material map texture
  texture: Texture;
  // Material map color
  color: Color;
  // Material map value
  value: c_float;
}

public struct Float4 {
  _0: c_float;
  _1: c_float;
  _2: c_float;
  _3: c_float;
}

// Material, includes shader and maps
public struct Material {
  // Material shader
  shader: Shader;
  // Material maps array (MAX_MATERIAL_MAPS)
  maps: *MaterialMap;
  // Material generic parameters (if required)
  params: Float4;
}

// Transform, vertex transformation data
public struct Transform {
  // Translation
  translation: Vector3;
  // Rotation
  rotation: Vector4;
  // Scale
  scale: Vector3;
}

public struct Byte32 {
  _1_8: int;
  _9_16: int;
  _17_24: int;
  _25_32: int;
}

// Bone, skeletal animation bone
public struct BoneInfo {
  // Bone name
  name: Byte32;
  // Bone parent
  parent: c_int;
}

// Model, meshes, materials and animation data
public struct Model {
  // Local transform matrix
  transform: Matrix;

  // Number of meshes
  meshCount: c_int;
  // Number of materials
  materialCount: c_int;
  // Meshes array
  meshes: *Mesh;
  // Materials array
  materials: *Material;
  // Mesh material number
  meshMaterial: *c_int;

  // Animation data

  // Number of bones
  boneCount: c_int;
  // Bones information (skeleton)
  bones: *BoneInfo;
  // Bones base transformation (pose)
  bindPose: *Transform;
}

// ModelAnimation
public struct ModelAnimation {
  // Number of bones
  boneCount: c_int;
  // Number of animation frames
  frameCount: c_int;
  // Bones information (skeleton)
  bones: *BoneInfo;
  // Poses array by frame
  framePoses: **Transform;
  // Animation name
  name: Byte32;
}

// Ray, ray for raycasting
public struct Ray {
  // Ray position (origin)
  position: Vector3;
  // Ray direction (normalized)
  direction: Vector3;
}

// RayCollision, ray hit information
public struct RayCollision {
  // Did the ray hit something?
  hit: bool;
  // Distance to the nearest hit
  distance: c_float;
  // Point of the nearest hit
  point: Vector3;
  // Surface normal of hit
  normal: Vector3;
}

// BoundingBox
public struct BoundingBox {
  // Minimum vertex box-corner
  min: Vector3;
  // Maximum vertex box-corner
  max: Vector3;
}

// Wave, audio wave data
public struct Wave {
  // Total number of frames (considering channels)
  frameCount: c_int;
  // Frequency (samples per second)
  sampleRate: c_int;
  // Bit depth (bits per sample): 8, 16, 32 (24 not supported)
  sampleSize: c_int;
  // Number of channels (1-mono, 2-stereo, ...)
  channels: c_int;
  // Buffer data pointer
  data: *void;
}

// AudioStream, custom audio stream
public struct AudioStream {
  // Pointer to internal data used by the audio system
  buffer: *void;
  // Pointer to internal data processor, useful for audio effects
  processor: *void;

  // Frequency (samples per second)
  sampleRate: c_int;
  // Bit depth (bits per sample): 8, 16, 32 (24 not supported)
  sampleSize: c_int;
  // Number of channels (1-mono, 2-stereo, ...)
  channels: c_int;
}

// Sound
public struct Sound {
  // Audio stream
  stream: AudioStream;
  // Total number of frames (considering channels)
  frameCount: c_int;
}

// Music, audio stream, anything longer than ~10 seconds should be streamed
public struct Music {
  // Audio stream
  stream: AudioStream;
  // Total number of frames (considering channels)
  frameCount: c_int;
  // Music looping enable
  looping: bool;

  // Type of music context (audio filetype)
  ctxType: c_int;
  // Audio context data, depends on type
  ctxData: *void;
}

// VrDeviceInfo, Head-Mounted-Display device parameters
public struct VrDeviceInfo {
  // Horizontal resolution in pixels
  hResolution: c_int;
  // Vertical resolution in pixels
  vResolution: c_int;
  // Horizontal size in meters
  hScreenSize: c_float;
  // Vertical size in meters
  vScreenSize: c_float;
  // Distance between eye and display in meters
  eyeToScreenDistance: c_float;
  // Lens separation distance in meters
  lensSeparationDistance: c_float;
  // IPD (distance between pupils) in meters
  interpupillaryDistance: c_float;
  // Lens distortion constant parameters
  lensDistortionValues: Float4;
  // Chromatic aberration correction parameters
  chromaAbCorrection: Float4;
}

public struct Float2 {
  _0: c_float;
  _1: c_float;
}

// VrStereoConfig, VR stereo rendering configuration for simulator
public struct VrStereoConfig {
  // VR projection matrices (per eye)
  projectionLeft: Matrix;
  projectionRight: Matrix;
  // VR view offset matrices (per eye)
  viewOffsetLeft: Matrix;
  viewOffsetRight: Matrix;
  // VR left lens center
  leftLensCenter: Float2;
  // VR right lens center
  rightLensCenter: Float2;
  // VR left screen center
  leftScreenCenter: Float2;
  // VR right screen center
  rightScreenCenter: Float2;
  // VR distortion scale
  scale: Float2;
  // VR distortion scale in
  scaleIn: Float2;
}

// File path list
public struct FilePathList {
  // Filepaths max entries
  capacity: c_int;
  // Filepaths entries count
  count: c_int;
  // Filepaths entries
  paths: **byte;
}

public struct Int4 {
  _0: c_int;
  _1: c_int;
  _2: c_int;
  _3: c_int;
}

// Automation event
public struct AutomationEvent {
  // Event frame
  frame: c_int;
  // Event type (AutomationEventType)
  type: c_int;
  // Event parameters (if required)
  params: Int4;
}

// Automation event list
public struct AutomationEventList {
  // Events max entries (MAX_AUTOMATION_EVENTS)
  capacity: c_int;
  // Events entries count
  count: c_int;
  // Events entries
  events: *AutomationEvent;
}

// Window-related functions
// Initialize window and OpenGL contexts
public native fn InitWindow(width: c_int, height: c_int, title: *byte) -> void;

// Close window and unload OpenGL context
public native fn CloseWindow() -> void;

// Check if application should close (pressed: KEY_ESCAPE or windows close icon clicked)
public native fn WindowShouldClose() -> bool;

// Check if window has been initialized successfully
public native fn IsWindowReady() -> bool;

// Check if window is currently fullscreen
public native fn IsWindowFullscreen() -> bool;

// Check if window is currently hidden
public native fn IsWindowHidden() -> bool;

// Check if window is currently minimized
public native fn IsWindowMinimized() -> bool;

// Check if window is currently maximized
public native fn IsWindowMaximized() -> bool;

// Check if window is currently focused
public native fn IsWindowFocused() -> bool;

// Check if window has been resized last frame
public native fn IsWindowResized() -> bool;

// Check if one specific window flag is enabled
public native fn IsWindowState(flag: c_int) -> bool;

// Set window configuration state using flags
public native fn SetWindowState(flags: c_int) -> void;

// Clear window configuration state flags
public native fn ClearWindowState(flags: c_int) -> void;

// Toggle window state: fullscreen/windowed, resizes monitor to match window resolution
public native fn ToggleFullscreen() -> void;

// Toggle window state: borderless windowed, resizes window to match monitor resolution
public native fn ToggleBorderlessWindowed() -> void;

// Set window state: maximized, if resizable
public native fn MaximizeWindow() -> void;

// Set window state: minimized, if resizable
public native fn MinimizeWindow() -> void;

// Restore window from being minimized/maximized
public native fn RestoreWindow() -> void;

// Set icon for window (single image, RGBA 32bit)
public native fn SetWindowIcon(image: Image) -> void;

// Set icon for window (multiple images, RGBA 32bit)
public native fn SetWindowIcons(images: *Image, count: c_int) -> void;

// Set title for window
public native fn SetWindowTitle(title: *byte) -> void;

// Set window position on screen
public native fn SetWindowPosition(x: c_int, y: c_int) -> void;

// Set monitor for the current window
public native fn SetWindowMonitor(monitor: c_int) -> void;

// Set window minimum dimensions (for FLAG_WINDOW_RESIZABLE)
public native fn SetWindowMinSize(width: c_int, height: c_int) -> void;

// Set window maximum dimensions (for FLAG_WINDOW_RESIZABLE)
public native fn SetWindowMaxSize(width: c_int, height: c_int) -> void;

// Set window dimensions
public native fn SetWindowSize(width: c_int, height: c_int) -> void;

// Set window opacity [0.0f..1.0f]
public native fn SetWindowOpacity(opacity: c_float) -> void;

// Set window focused
public native fn SetWindowFocused() -> void;

// Get native window handle
public native fn GetWindowHandle() -> *void;

// Get current screen width
public native fn GetScreenWidth() -> c_int;

// Get current screen height
public native fn GetScreenHeight() -> c_int;

// Get current render width (it considers HiDPI)
public native fn GetRenderWidth() -> c_int;

// Get current render height (it considers HiDPI)
public native fn GetRenderHeight() -> c_int;

// Get number of connected monitors
public native fn GetMonitorCount() -> c_int;

// Get current monitor where window is placed
public native fn GetCurrentMonitor() -> c_int;

// Get specified monitor position
public native fn GetMonitorPosition(monitor: c_int) -> Vector2;

// Get specified monitor width (current video mode used by monitor)
public native fn GetMonitorWidth(monitor: c_int) -> c_int;

// Get specified monitor height (current video mode used by monitor)
public native fn GetMonitorHeight(monitor: c_int) -> c_int;

// Get specified monitor physical width in millimetres
public native fn GetMonitorPhysicalWidth(monitor: c_int) -> c_int;

// Get specified monitor physical height in millimetres
public native fn GetMonitorPhysicalHeight(monitor: c_int) -> c_int;

// Get specified monitor refresh rate
public native fn GetMonitorRefreshRate(monitor: c_int) -> c_int;

// Get window position XY on monitor
public native fn GetWindowPosition() -> Vector2;

// Get window scale DPI factor
public native fn GetWindowScaleDPI() -> Vector2;

// Get the human-readable, UTF-8 encoded name of the specified monitor
public native fn GetMonitorName(monitor: c_int) -> *byte;

// Set clipboard text content
public native fn SetClipboardText(text: *byte) -> void;

// Get clipboard text content
public native fn GetClipboardText() -> *byte;

// Get clipboard image content
public native fn GetClipboardImage() -> Image;

// Enable waiting for events on EndDrawing(), no automatic event polling
public native fn EnableEventWaiting() -> void;

// Disable waiting for events on EndDrawing(), automatic events polling
public native fn DisableEventWaiting() -> void;


// Cursor-related functions

// Shows cursor
public native fn ShowCursor() -> void;

// Hides cursor
public native fn HideCursor() -> void;

// Check if cursor is not visible
public native fn IsCursorHidden() -> bool;

// Enables cursor (unlock cursor)
public native fn EnableCursor() -> void;

// Disables cursor (lock cursor)
public native fn DisableCursor() -> void;

// Check if cursor is on the screen
public native fn IsCursorOnScreen() -> bool;


// Drawing-related functions


// Set background color (framebuffer clear color)
public native fn ClearBackground(color: Color) -> void;

// Setup canvas (framebuffer) to start drawing
public native fn BeginDrawing() -> void;

// End canvas drawing and swap buffers (double buffering)
public native fn EndDrawing() -> void;

// Begin 2D mode with custom camera (2D)
public native fn BeginMode2D(camera: Camera2D) -> void;

// Ends 2D mode with custom camera
public native fn EndMode2D() -> void;

// Begin 3D mode with custom camera (3D)
public native fn BeginMode3D(camera: Camera3D) -> void;

// Ends 3D mode and returns to default 2D orthographic mode
public native fn EndMode3D() -> void;

// Begin drawing to render texture
public native fn BeginTextureMode(target: RenderTexture) -> void;

// Ends drawing to render texture
public native fn EndTextureMode() -> void;

// Begin custom shader drawing
public native fn BeginShaderMode(shader: Shader) -> void;

// End custom shader drawing (use default shader)
public native fn EndShaderMode() -> void;

// Begin blending mode (alpha, additive, multiplied, subtract, custom)
public native fn BeginBlendMode(mode: c_int) -> void;

// End blending mode (reset to default: alpha blending)
public native fn EndBlendMode() -> void;

// Begin scissor mode (define screen area for following drawing)
public native fn BeginScissorMode(x: c_int, y: c_int, width: c_int, height: c_int) -> void;

// End scissor mode
public native fn EndScissorMode() -> void;

// Begin stereo rendering (requires VR simulator)
public native fn BeginVrStereoMode(config: VrStereoConfig) -> void;

// End stereo rendering (requires VR simulator)
public native fn EndVrStereoMode() -> void;


// VR stereo config functions for VR simulator


// Load VR stereo config for VR simulator device parameters
public native fn LoadVrStereoConfig(device: VrDeviceInfo) -> VrStereoConfig;

// Unload VR stereo config
public native fn UnloadVrStereoConfig(config: VrStereoConfig) -> void;


// Shader management functions


// NOTE: Shader functionality is not available on OpenGL 1.1


// Load shader from files and bind default locations
public native fn LoadShader(vsFileName: *byte, fsFileName: *byte) -> Shader;

// Load shader from code strings and bind default locations
public native fn LoadShaderFromMemory(vsCode: *byte, fsCode: *byte) -> Shader;

// Check if a shader is valid (loaded on GPU)
public native fn IsShaderValid(shader: Shader) -> bool;

// Get shader uniform location
public native fn GetShaderLocation(shader: Shader, uniformName: *byte) -> c_int;

// Get shader attribute location
public native fn GetShaderLocationAttrib(shader: Shader, attribName: *byte) -> c_int;

// Set shader uniform value
public native fn SetShaderValue(shader: Shader, locIndex: c_int, value: *void, uniformType: c_int) -> void;

// Set shader uniform value vector
public native fn SetShaderValueV(shader: Shader, locIndex: c_int, value: *void, uniformType: c_int, count: c_int) -> void;

// Set shader uniform value (matrix 4x4)
public native fn SetShaderValueMatrix(shader: Shader, locIndex: c_int, mat: Matrix) -> void;

// Set shader uniform value and bind the texture (sampler2d)
public native fn SetShaderValueTexture(shader: Shader, locIndex: c_int, texture: Texture) -> void;

// Unload shader from GPU memory (VRAM)
public native fn UnloadShader(shader: Shader) -> void;


// Screen-space-related functions


// Get a ray trace from screen position (i.e mouse)
public native fn GetScreenToWorldRay(position: Vector2, camera: Camera3D) -> Ray;

// Get a ray trace from screen position (i.e mouse) in a viewport
public native fn GetScreenToWorldRayEx(position: Vector2, camera: Camera3D, width: c_int, height: c_int) -> Ray;

// Get the screen space position for a 3d world space position
public native fn GetWorldToScreen(position: Vector3, camera: Camera3D) -> Vector2;

// Get size position for a 3d world space position
public native fn GetWorldToScreenEx(position: Vector3, camera: Camera3D, width: c_int, height: c_int) -> Vector2;

// Get the screen space position for a 2d camera world space position
public native fn GetWorldToScreen2D(position: Vector2, camera: Camera2D) -> Vector2;

// Get the world space position for a 2d camera screen space position
public native fn GetScreenToWorld2D(position: Vector2, camera: Camera2D) -> Vector2;

// Get camera transform matrix (view matrix)
public native fn GetCameraMatrix(camera: Camera3D) -> Matrix;

// Get camera 2d transform matrix
public native fn GetCameraMatrix2D(camera: Camera2D) -> Matrix;


// Timing-related functions


// Set target FPS (maximum)
public native fn SetTargetFPS(fps: c_int) -> void;

// Get time in seconds for last frame drawn (delta time)
public native fn GetFrameTime() -> c_float;

// Get elapsed time in seconds since InitWindow()
public native fn GetTime() -> float;

// Get current FPS
public native fn GetFPS() -> c_int;


// Custom frame control functions


// NOTE: Those functions are c_intended for advanced users that want full control over the frame processing


// By default EndDrawing() does this job: draws everything + SwapScreenBuffer() + manage frame timing + PollInputEvents()


// To avoid that behaviour and control frame processes manually, enable in config.h: SUPPORT_CUSTOM_FRAME_CONTROL


// Swap back buffer with front buffer (screen drawing)
public native fn SwapScreenBuffer() -> void;

// Register all input events
public native fn PollInputEvents() -> void;

// Wait for some time (halt program execution)
public native fn WaitTime(seconds: float) -> void;


// Random values generation functions


// Set the seed for the random number generator
public native fn SetRandomSeed(seed: c_int) -> void;

// Get a random value between min and max (both included)
public native fn GetRandomValue(min: c_int, max: c_int) -> c_int;

// Load random values sequence, no values repeated
public native fn LoadRandomSequence(count: c_int, min: c_int, max: c_int) -> *c_int;

// Unload random values sequence
public native fn UnloadRandomSequence(sequence: *c_int) -> void;


// Misc. functions


// Takes a screenshot of current screen (filename extension defines format)
public native fn TakeScreenshot(fileName: *byte) -> void;

// Setup init configuration flags (view FLAGS)
public native fn SetConfigFlags(flags: c_int) -> void;

// Open URL with default system browser (if available)
public native fn OpenURL(url: *byte) -> void;


// Logging system


// Set the current threshold (minimum) log level
public native fn SetTraceLogLevel(logLevel: c_int) -> void;

// Show trace log messages (LOG_DEBUG, LOG_INFO, LOG_WARNING, LOG_ERROR...)
public native fn TraceLog(logLevel: c_int, text: *byte) -> void;

// Set custom trace log
public native fn SetTraceLogCallback(callback: fn(c_int, *byte) -> void) -> void;


// Memory management, using c_internal allocators


// c_internal memory allocator
public native fn MemAlloc(size: c_int) -> *void;

// c_internal memory reallocator
public native fn MemRealloc(ptr: *void, size: c_int) -> *void;

// c_internal memory free
public native fn MemFree(ptr: *void) -> void;


// File system management functions


// Load file data as byte array (read)
public native fn LoadFileData(fileName: *byte, dataSize: *c_int) -> *byte;

// Unload file data allocated by LoadFileData()
public native fn UnloadFileData(data: *byte) -> void;

// Save data to file from byte array (write), returns true on success
public native fn SaveFileData(fileName: *byte, data: *void, dataSize: c_int) -> bool;

// Export data to code (.h), returns true on success
public native fn ExportDataAsCode(data: *byte, dataSize: c_int, fileName: *byte) -> bool;

// Load text data from file (read), returns a '\0' terminated string
public native fn LoadFileText(fileName: *byte) -> *byte;

// Unload file text data allocated by LoadFileText()
public native fn UnloadFileText(text: *byte) -> void;

// Save text data to file (write), string must be '\0' terminated, returns true on success
public native fn SaveFileText(fileName: *byte, text: *byte) -> bool;


// File access custom callbacks


// WARNING: Callbacks setup is c_intended for advanced users


// Set custom file binary data loader
public native fn SetLoadFileDataCallback(callback: fn(*byte, *c_int) -> *byte) -> void;

// Set custom file binary data saver
public native fn SetSaveFileDataCallback(callback: fn(*byte, *void, c_int) -> bool) -> void;

// Set custom file text data loader
public native fn SetLoadFileTextCallback(callback: fn(*byte) -> *byte) -> void;

// Set custom file text data saver
public native fn SetSaveFileTextCallback(callback: fn(*byte, *byte) -> bool) -> void;


// Rename file (if exists)
public native fn FileRename(fileName: *byte, fileRename: *byte) -> c_int;

// Remove file (if exists)
public native fn FileRemove(fileName: *byte) -> c_int;

// Copy file from one path to another, dstPath created if it doesn't exist
public native fn FileCopy(srcPath: *byte, dstPath: *byte) -> c_int;

// Move file from one directory to another, dstPath created if it doesn't exist
public native fn FileMove(srcPath: *byte, dstPath: *byte) -> c_int;

// Replace text in an existing file
public native fn FileTextReplace(fileName: *byte, search: *byte, replacement: *byte) -> c_int;

// Find text in existing file
public native fn FileTextFindIndex(fileName: *byte, search: *byte) -> c_int;

// Check if file exists
public native fn FileExists(fileName: *byte) -> bool;

// Check if a directory path exists
public native fn DirectoryExists(dirPath: *byte) -> bool;

// Check file extension (recommended include point: .png, .wav)
public native fn IsFileExtension(fileName: *byte, ext: *byte) -> bool;

// Get file length in bytes (NOTE: GetFileSize() conflicts with windows.h)
public native fn GetFileLength(fileName: *byte) -> c_int;

// Get file modification time (last write time)
public native fn GetFileModTime(fileName: *byte) -> c_int;

// Get pointer to extension for a filename string (includes dot: '.png')
public native fn GetFileExtension(fileName: *byte) -> *byte;

// Get pointer to filename for a path string
public native fn GetFileName(filePath: *byte) -> *byte;

// Get filename string without extension (uses static string)
public native fn GetFileNameWithoutExt(filePath: *byte) -> *byte;

// Get full path for a given fileName with path (uses static string)
public native fn GetDirectoryPath(filePath: *byte) -> *byte;

// Get previous directory path for a given path (uses static string)
public native fn GetPrevDirectoryPath(dirPath: *byte) -> *byte;

// Get current working directory (uses static string)
public native fn GetWorkingDirectory() -> *byte;

// Get the directory of the running application (uses static string)
public native fn GetApplicationDirectory() -> *byte;

// Create directories (including full path requested), returns 0 on success
public native fn MakeDirectory(dirPath: *byte) -> c_int;

// Change working directory, return true on success
public native fn ChangeDirectory(dirPath: *byte) -> bool;

// Check if a given path is a file or a directory
public native fn IsPathFile(path: *byte) -> bool;

// Check if fileName is valid for the platform/OS
public native fn IsFileNameValid(fileName: *byte) -> bool;

// Load directory filepaths, files and directories, no subdirs scan
public native fn LoadDirectoryFiles(dirPath: *byte) -> FilePathList;

// Load directory filepaths with extension filtering and subdir scan;some filters available: "*.*", "*FILES", "*DIRS"
public native fn LoadDirectoryFilesEx(basePath: *byte, filter: *byte, scanSubdirs: bool) -> FilePathList;

// Unload filepaths
public native fn UnloadDirectoryFiles(files: FilePathList) -> void;

// Check if a file has been dropped c_into window
public native fn IsFileDropped() -> bool;

// Load dropped filepaths
public native fn LoadDroppedFiles() -> FilePathList;

// Unload dropped filepaths
public native fn UnloadDroppedFiles(files: FilePathList) -> void;

// Get the file count in a directory
public native fn GetDirectoryFileCount(dirPath: *byte) -> c_int;

// Get the file count in a directory with extension filtering and recursive directory scan. Use 'DIR' in the filter string to include directories in the result
public native fn GetDirectoryFileCountEx(basePath: *byte, filter: *byte, scanSubdirs: bool) -> c_int;


// Compression/Encoding functionality

// Compress data (algorithm: DEFLATE), memory must be MemFree()
public native fn CompressData(data: *byte, dataSize: c_int, compDataSize: *c_int) -> *byte;

// Decompress data (algorithm: DEFLATE), memory must be MemFree()
public native fn DecompressData(compData: *byte, compDataSize: c_int, dataSize: *c_int) -> *byte;

// Encode data to Base64 string (includes NULL terminator), memory must be MemFree()
public native fn EncodeDataBase64(data: *byte, dataSize: c_int, outputSize: *c_int) -> *byte;

// Decode Base64 string (expected NULL terminated), memory must be MemFree()
public native fn DecodeDataBase64(text: *byte, outputSize: *c_int) -> *byte;

// Compute CRC32 hash code
public native fn ComputeCRC32(data: *byte, dataSize: c_int) -> c_int;

// Compute MD5 hash code, returns static c_int[4] (16 bytes)
public native fn ComputeMD5(data: *byte, dataSize: c_int) -> *c_int;

// Compute SHA1 hash code, returns static c_int[5] (20 bytes)
public native fn ComputeSHA1(data: *byte, dataSize: c_int) -> *c_int;

// Compute SHA256 hash code, returns static c_int[8] (32 bytes)
public native fn ComputeSHA256(data: *byte, dataSize: c_int) -> *c_int;


// Automation events functionality


// Load automation events list from file, NULL for empty list, capacity = MAX_AUTOMATION_EVENTS
public native fn LoadAutomationEventList(fileName: *byte) -> AutomationEventList;

// Unload automation events list from file
public native fn UnloadAutomationEventList(list: AutomationEventList) -> void;

// Export automation events list as text file
public native fn ExportAutomationEventList(list: AutomationEventList, fileName: *byte) -> bool;

// Set automation event list to record to
public native fn SetAutomationEventList(list: *AutomationEventList) -> void;

// Set automation event c_internal base frame to start recording
public native fn SetAutomationEventBaseFrame(frame: c_int) -> void;

// Start recording automation events (must: AutomationEventList be set)
public native fn StartAutomationEventRecording() -> void;

// Stop recording automation events
public native fn StopAutomationEventRecording() -> void;

// Play a recorded automation event
public native fn PlayAutomationEvent(event: AutomationEvent) -> void;


