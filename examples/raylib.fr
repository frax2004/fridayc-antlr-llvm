// Check the collision between two lines defined by two points each, returns collision point by reference
public native fn CheckCollisionLines(startPos1: Vector2, endPos1: Vector2, startPos2: Vector2, endPos2: Vector2, collisionPoint: *Vector2) -> bool;

// Get collision rectangle for two rectangles collision
public native fn GetCollisionRec(rec1: Rectangle, rec2: Rectangle) -> Rectangle;

