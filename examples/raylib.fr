// Remove text spaces, concat words
public native fn TextRemoveSpaces(text: *byte) -> *byte;

// Get text between two strings
public native fn GetTextBetween(text: *byte, begin: *byte, end: *byte) -> *byte;

// Replace text string with new string
public native fn TextReplace(text: *byte, search: *byte, replacement: *byte) -> *byte;

// Replace text string with new string, memory must be MemFree()
public native fn TextReplaceAlloc(text: *byte, search: *byte, replacement: *byte) -> *byte;

// Replace text between two specific strings
public native fn TextReplaceBetween(text: *byte, begin: *byte, end: *byte, replacement: *byte) -> *byte;

// Replace text between two specific strings, memory must be MemFree()
public native fn TextReplaceBetweenAlloc(text: *byte, begin: *byte, end: *byte, replacement: *byte) -> *byte;

// Insert text in a defined byte position
public native fn TextInsert(text: *byte, insert: *byte, position: c_int) -> *byte;

// Insert text in a defined byte position, memory must be MemFree()
public native fn TextInsertAlloc(text: *byte, insert: *byte, position: c_int) -> *byte;

// Join text strings with delimiter
public native fn TextJoin(textList: **byte, count: c_int, delimiter: *byte) -> *byte;

// Split text c_into multiple strings, using MAX_TEXTSPLIT_COUNT static strings
