
using Libc;
using Raylib;
using Math;

fn neighborhood(grid: []bool, cells: int, linidx: int) -> int => grid[linidx-1] as int
  + grid[linidx+1] as int
  + grid[linidx-cells-1] as int
  + grid[linidx-cells] as int
  + grid[linidx-cells+1] as int
  + grid[linidx+cells-1] as int
  + grid[linidx+cells] as int
  + grid[linidx+cells+1] as int
;

fn main(argc: int, argv: **byte) -> void {
  const args = new []*byte {
    ptr: argv,
    len: argc
  };

  const CELLS = 50;

  let front_grid = new []bool {
    ptr: Libc.calloc(CELLS*CELLS, sizeof bool) as *bool,
    len: CELLS*CELLS
  };
  defer Libc.free(front_grid.ptr as *void);

  let back_grid = new []bool {
    ptr: Libc.calloc(CELLS*CELLS, sizeof bool) as *bool,
    len: CELLS*CELLS
  };
  defer Libc.free(back_grid.ptr as *void);

  for i : 1 .. args.len-1 where i%2 == 1 {
    back_grid[Libc.atoi(args[i])*CELLS + Libc.atoi(args[i+1])] = true;
  }

  Raylib.InitWindow(800 as c_int, 800 as c_int, "Friday - GameOfLife");
  defer Raylib.CloseWindow();
  Raylib.SetTargetFPS(10 as c_int);

  const cell_w = (Raylib.GetRenderWidth() as int)/CELLS;
  const cell_h = (Raylib.GetRenderHeight() as int)/CELLS;

  while !Raylib.WindowShouldClose() {

    Raylib.BeginDrawing();

    for i : 0 .. CELLS {
      for j : 0 .. CELLS {
        let color = Raylib.Color.rgb(255, 215, 0);
        if !back_grid[i*CELLS+j] {
          color = Raylib.Color.rgb(0, 0, 0);
        }
        Raylib.DrawRectangle(
          (i * cell_w) as c_int, 
          (j * cell_h) as c_int, 
          cell_w as c_int, 
          cell_h as c_int, 
          color
        );
      }
    }

    Raylib.EndDrawing();

    for i : 1 .. CELLS-1 {
      for j : 1 .. CELLS-1 {
        const idx = i*CELLS+j;
        const n = neighborhood(back_grid, CELLS, idx);
        const self_alive = back_grid[idx];
        if self_alive && n < 2 { 
          front_grid[idx] = false; 
        } elif self_alive && (n == 2 || n == 3) {
          front_grid[idx] = true;
        } elif self_alive && n > 3 { 
          front_grid[idx] = false; 
        } elif !self_alive && n == 3 {
          front_grid[idx] = true;
        }
      }
    }

    if Raylib.IsMouseButtonDown(0 as c_int) {
      const pos = Raylib.GetMousePosition();
      const dx = pos.x as float/Raylib.GetRenderWidth() as int as float;
      const dy = pos.y as float/Raylib.GetRenderHeight() as int as float;
      const i = Math.clamp(0, (dx * CELLS as float) as int, CELLS-1);
      const j = Math.clamp(0, (dy * CELLS as float) as int, CELLS-1);

      front_grid[i*CELLS + j] = true;
    }

    Libc.memset(back_grid.ptr as *void, 0, sizeof bool * CELLS * CELLS);
    const tmp = back_grid;
    back_grid = front_grid;
    front_grid = tmp;
  }
}
