namespace Math;

public native fn pow(x: float, y: float) -> float;
public native fn sqrt(x: float) -> float;
public native fn cbrt(x: float) -> float;
public native fn exp(x: float) -> float;

public fn clamp(min: int, x: int, max: int) -> int {
  if x < min { return min; }
  elif x > max { return max; }
  else return x;
}

public fn clamp(min: float, x: float, max: float) -> float {
  if x < min { return min; }
  elif x > max { return max; }
  else return x;
}